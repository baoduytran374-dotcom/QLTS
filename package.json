{
  "name": "betma-dashboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "BETMA ENGLISH — Dashboard tuyển sinh & tài chính 2026 (Vite + Chart.js, deploy GitHub Pages, dữ liệu lưu trên Cloudflare Worker + R2)",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test",
    "data:build": "node scripts/build-data.mjs",
    "data:push": "node scripts/push-data.mjs",
    "worker:dev": "npx wrangler@3 dev --config worker/wrangler.toml",
    "worker:deploy": "npx wrangler@3 deploy --config worker/wrangler.toml"
  },
  "dependencies": {
    "chart.js": "^4.4.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "vite": "^5.4.10"
  },
  "engines": {
    "node": ">=20"
  }
}
